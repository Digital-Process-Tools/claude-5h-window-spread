{
  "repo": "Digital-Process-Tools/claude-5h-window-spread",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "python3 -m unittest discover -s tests",
  "version_sites": [
    ".claude-plugin/plugin.json"
  ],
  "changelog_dir": "changelog.d",
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "priority": [],
    "lanes": []
  },
  "milestones": [],
  "release": {
    "authority": "loop",
    "tag_pattern": "v{version}",
    "merge_method": "squash",
    "commit_subject": null,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  }
}
